{
  "name": "vite-soft-ui-dashboard",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "cross-env CI=false vite build",
    "preview": "vite preview --port 8080",
    "lint": "eslint --ext .js,.vue --ignore-path .gitignore --fix src",
    "format": "prettier .  --write",
    "rum:simulate": "node scripts/headless-rum-simulator.js",
    "rum:simulate:10": "node scripts/headless-rum-simulator.js --users=10",
    "rum:simulate:timed": "node scripts/headless-rum-simulator.js --users=5 --duration=60"
  },
  "dependencies": {
    "@motadata365/browser-rum": "^6.21.19",
    "@popperjs/core": "2.10.2",
    "bootstrap": "5.1.3",
    "chart.js": "3.6.0",
    "jkanban": "^1.3.1",
    "vue": "^3.2.25",
    "vue-router": "^4.0.14",
    "vuex": "^4.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.11.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-vue": "^8.5.0",
    "prettier": "2.6.0",
    "puppeteer": "^24.32.0",
    "sass": "^1.49.9",
    "vite": "^7.1.12"
  }
}
